# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENROUTER_API_KEY: Used by /api/generate-voiceovers to call Fish Audio S2.1 Pro / audio speech models via OpenRouter.
# Get your key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""

# FISH_AUDIO_API_KEY: Optional direct Fish Audio API key for S2.1 Pro TTS (https://fish.audio/app/api-keys/).
FISH_AUDIO_API_KEY=""

# FISH_AUDIO_VOICE_ID: Official Fish Audio narrator voice ID ("Adrian" — steady male documentary explainer voice).
# Picked from https://fish.audio/m/bf322df2096a46f18c579d0baa36f41d
FISH_AUDIO_VOICE_ID="bf322df2096a46f18c579d0baa36f41d"

# GITHUB_PERSONAL_ACCESS_TOKEN: Personal Access Token with full repo & workflow scopes for /api/push-github.
# Generate at: https://github.com/settings/tokens/new?description=HyperFrames+3D+Studio+Full+Access&scopes=repo,workflow,write:packages,delete_repo,read:org
GITHUB_PERSONAL_ACCESS_TOKEN=""

# GITHUB_REPO: Target GitHub repository in "owner/repo" format (e.g. "username/apple-cyanide-3d-explainer").
GITHUB_REPO="apple-cyanide-3d-explainer"
